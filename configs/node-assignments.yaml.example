# ── Model registry ──────────────────────────────────
# Add new models here. They become available for assignment.
# Source types:
#   huggingface  — pre-converted MLX weights from any HF repo
#   convert      — auto-convert + quantize any HF model to MLX
#   local        — model already on disk (manual management)
#   pip          — installable tool (image/video gen, not served by vllm-mlx)
models:
  coder:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3-Coder-Next-4bit"
      revision: "main"
    disk_gb: 44.8
    kv_per_32k_gb: 0.75
    active_params: "3B of 80B"
    max_context: 262144
    notes: "Best for agentic coding (tool calling, error recovery)."

  fast:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3.5-9B-MLX-4bit"
      revision: "main"
    disk_gb: 5.6
    kv_per_32k_gb: 0.3
    active_params: "9B dense"
    max_context: 262144
    notes: "Fast fallback for simple queries. ~80-120 tok/s on M4 Max."

  embedding:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ"
      revision: "main"
    disk_gb: 0.5
    active_params: "0.6B"
    max_context: 8192
    serving: embedding
    notes: "Lazy-loaded embedding model, ~0.5 GB RAM."

  # Optional: serve chat models through mlx-openai-server instead of mlx_lm.server.
  # Useful for models that need a parser, e.g. gpt-oss Harmony channels.
  # Keep parser flags in extra_args so the serving mode stays generic.
  # gpt-oss-20b:
  #   source:
  #     type: huggingface
  #     repo: "mlx-community/gpt-oss-20b-MXFP4-Q8"
  #     revision: "main"
  #   disk_gb: 12.1
  #   kv_per_32k_gb: 8.0
  #   max_context: 131072
  #   serving: mlx-openai-server
  #   extra_args:
  #     - --reasoning-parser
  #     - harmony
  #     - --tool-call-parser
  #     - harmony
  #   notes: "gpt-oss/Harmony example; smoke-test output before routing production traffic."

# ── Nodes ──────────────────────────────────────────
# Per-node host may be a DNS name or IP address. Prefer .lan FQDNs.
# Per-node user is optional. Falls back to TF_SSH_USER env var,
# then $USER (current OS user). Role is "node" (compute) or "gateway" (infra/hub).
nodes:
  rock: { host: "rock.lan", ram_gb: 32, role: gateway }
  msm1: { host: "msm1-wifi.lan", ram_gb: 128, role: node }
  msm2: { host: "msm2-wifi.lan", ram_gb: 128, role: node }
  # Add more nodes as needed:
  # mynode: { host: "mynode.lan", ram_gb: 64, role: node, user: myuser }

# ── Node assignments ────────────────────────────────
# Each node gets a list of {model, port} pairs.
# One vllm-mlx process per entry.
assignments:
  msm1:
    - model: coder
      port: 8000
  msm2:
    - model: coder
      port: 8000
  # Multi-model setup example:
  # msm3:
  #   - model: coder
  #     port: 8000
  #   - model: fast
  #     port: 8001
