# ── Model registry ──────────────────────────────────
# Add new models here. They become available for assignment.
# Source types:
#   huggingface  — pre-converted MLX weights from any HF repo
#   convert      — auto-convert + quantize any HF model to MLX
#   local        — model already on disk (manual management)
#   pip          — installable tool (image/video gen, not served by vllm-mlx)
models:
  coder:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3-Coder-Next-4bit"
      revision: "main"
    disk_gb: 44.8
    kv_per_32k_gb: 0.75
    active_params: "3B of 80B"
    max_context: 262144
    notes: "SOTA agentic coding. Tool calling, error recovery, 262K context."

  agent-qwen3.6:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3.6-35B-A3B-4bit"
      revision: "main"
    disk_gb: 20.5
    kv_per_32k_gb: 0.5
    active_params: "3B of 35B"
    max_context: 262144
    notes: "Fast agent. 73.4% SWE-bench. Thinking mode by default."

  agent-qwen3.5:
    source:
      type: huggingface
      repo: "mlx-community/Qwen3.5-122B-A10B-4bit"
      revision: "main"
    disk_gb: 65.0
    kv_per_32k_gb: 1.2
    active_params: "10B of 122B"
    max_context: 131072
    notes: "Heavy agent. 122B MoE with VLM support. Thinking mode."

  agent-llama4:
    source:
      type: huggingface
      repo: "mlx-community/Llama-4-Scout-17B-16E-Instruct-4bit"
      revision: "main"
    disk_gb: 61.0
    kv_per_32k_gb: 2.0
    active_params: "17B of 109B"
    max_context: 10485760
    notes: "10M context. Solid tool calling. Benchmark candidate."

  memory:
    source:
      type: huggingface
      repo: "lmstudio-community/gpt-oss-20b-MLX-8bit"
      revision: "main"
    disk_gb: 21.0
    kv_per_32k_gb: 8.0
    max_context: 131072
    serving: mlx-openai-server
    extra_args:
      - --reasoning-parser
      - harmony
      - --tool-call-parser
      - harmony
    notes: "Hindsight LLM (retain/reflect/consolidation). Recommended by Hindsight benchmarks. Requires mlx-openai-server, not standard oMLX serve."

# ── Nodes ──────────────────────────────────────────
# Per-node host may be a DNS name or IP address. Prefer .lan FQDNs.
# Per-node user is optional. Falls back to TF_SSH_USER env var,
# then $USER (current OS user). Role is "node" (compute) or "gateway" (infra/hub).
nodes:
  rock: { host: "rock.lan", ram_gb: 32, role: gateway }

  msm1:
    host: "msm1-wifi.lan"
    ram_gb: 128
    role: node
    user: shag
    runtime:
      type: omlx
      port: 8018

  msm2:
    host: "msm2-wifi.lan"
    ram_gb: 128
    role: node
    user: shag
    runtime:
      type: omlx
      port: 8018

  msm3:
    host: "msm3-wifi.lan"
    fabric_host: "msm3-fabric"
    ram_gb: 128
    role: node
    user: shag
    runtime:
      type: omlx
      port: 8018

  # msm4: reserved — dedicated direct oMLX node for Hindsight
  # (bypasses Olla cluster, managed separately)
  # host: "msm4-wifi.lan"
  # ram_gb: 128
  # role: node
  # user: shag

# ── Node assignments ────────────────────────────────
# Memory + Coder (msm1, msm2) or Memory + Agent (msm3).
# Olla LRU manages active model loading — not all models loaded simultaneously.
# Budget: memory ~12GB + coder/agent up to ~90GB = ~102GB of 110GB usable.
assignments:
  msm1:
    - model: memory
      role: memory
    - model: coder
      role: coder

  msm2:
    - model: memory
      role: memory
    - model: coder
      role: coder

  msm3:
    - model: memory
      role: memory
    - model: agent-qwen3.6
      role: agent
    - model: agent-qwen3.5
      role: agent
    - model: agent-llama4
      role: agent

# ── Node-level runtime routes ───────────────────────
# Optional dev routes for node runtimes such as oMLX. These expose a model
# already served by the node runtime through the generated LiteLLM config.
runtime_routes:
  # Coder (msm1, msm2)
  - model_name: qwen3-coder-next-omlx-msm1
    runtime: omlx
    node: msm1
    model: Qwen3-Coder-Next-4bit

  - model_name: qwen3-coder-next-omlx-msm2
    runtime: omlx
    node: msm2
    model: Qwen3-Coder-Next-4bit

  # Agent candidates (msm3 — benchmark to select best)
  - model_name: qwen3.6-35b-agent-omlx-msm3
    runtime: omlx
    node: msm3
    model: Qwen3.6-35B-A3B-4bit

  - model_name: qwen3.5-122b-agent-omlx-msm3
    runtime: omlx
    node: msm3
    model: Qwen3.5-122B-A10B-4bit

  - model_name: llama4-scout-agent-omlx-msm3
    runtime: omlx
    node: msm3
    model: Llama-4-Scout-17B-16E-Instruct-4bit

  # Memory (all nodes) — requires mlx-openai-server, not standard oMLX serve
  - model_name: gpt-oss-20b-memory-omlx-msm1
    runtime: mlx-openai-server
    node: msm1
    model: gpt-oss-20b-MLX-8bit

  - model_name: gpt-oss-20b-memory-omlx-msm2
    runtime: mlx-openai-server
    node: msm2
    model: gpt-oss-20b-MLX-8bit

  - model_name: gpt-oss-20b-memory-omlx-msm3
    runtime: mlx-openai-server
    node: msm3
    model: gpt-oss-20b-MLX-8bit
